APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
API_VERSION=v1

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

REVERB_APP_ID=booking-core-local
REVERB_APP_KEY=booking-core-local-key
REVERB_APP_SECRET=booking-core-local-secret
REVERB_HOST=reverb_api
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGIN=*

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PAYKEEPER_BASE_URL=
PAYKEEPER_CLIENT_ID=
PAYKEEPER_CLIENT_SECRET=
PAYKEEPER_TOKEN_PATH=/info/settings/token/
PAYKEEPER_INVOICE_PATH=/change/invoice/preview/
PAYKEEPER_REVOKE_PATH=/change/invoice/revoke/
PAYKEEPER_STATUS_PATH=/info/invoice/byid/
PAYKEEPER_CURRENCY=RUB
PAYKEEPER_INVOICE_TTL_MINUTES=30
PAYKEEPER_TOKEN_TTL_MINUTES=10
PAYKEEPER_CACHE_KEY=paykeeper:token
PAYKEEPER_TIMEOUT=10
PAYKEEPER_CONNECT_TIMEOUT=5

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
